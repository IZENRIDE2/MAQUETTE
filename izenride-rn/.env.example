# Copier en .env (jamais commité). Sans ces variables, l'app tourne en mode démo.
EXPO_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<clé anon publique>
# Table des profils existante (colonnes lues : id, display_name|username|first_name|name, avatar_url|photo_url)
EXPO_PUBLIC_SUPABASE_PROFILES_TABLE=profiles
EXPO_PUBLIC_SUPABASE_PROFILES_NAME_COLUMN=display_name
EXPO_PUBLIC_INVITE_BASE_URL=https://izenride.app
